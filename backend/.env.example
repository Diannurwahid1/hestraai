APP_ENV=development
PUBLIC_REGISTRATION_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./hestra.db
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_CACHE_TTL_SECONDS=300

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_EXTRA_HEADERS=
LLM_TIMEOUT_SECONDS=45

# Bynara Router example, if you want live AI instead of mock responses:
# LLM_PROVIDER=bynara
# LLM_API_KEY=your-bynara-router-key
# LLM_BASE_URL=https://your-bynara-router.example/v1
# LLM_MODEL=your-bynara-model
# LLM_EXTRA_HEADERS={"X-Router-Project":"hestra-ai"}
