APP_ENV=development
PUBLIC_REGISTRATION_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./hestra.db
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_CACHE_TTL_SECONDS=300
SECTORS_COMPANY_CACHE_TTL_SECONDS=3600
SECTORS_MINING_CACHE_TTL_SECONDS=86400
SECTORS_COMMODITY_CACHE_TTL_SECONDS=3600
HESTRA_ADMIN_EMAIL=

# Sandbox only. Never use a production SumoPod endpoint with this integration.
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_API_KEY=
# Configure either the signing secret (preferred) or the webhook token.
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_EXTRA_HEADERS=
LLM_TIMEOUT_SECONDS=45

# Bynara Router example, if you want live AI instead of mock responses:
# LLM_PROVIDER=bynara
# LLM_API_KEY=your-bynara-router-key
# LLM_BASE_URL=https://your-bynara-router.example/v1
# LLM_MODEL=your-bynara-model
# LLM_EXTRA_HEADERS={"X-Router-Project":"hestra-ai"}
