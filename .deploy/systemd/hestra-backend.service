[Unit]
Description=Hestra AI FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hestraai/backend
EnvironmentFile=/home/ubuntu/hestraai/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/hestraai/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
